generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum plan {
  FREE
  TEAM
  ENTERPRISE
}

enum scopes {
  OWNER

  // env
  READ_ENV
  WRITE_ENV
  DELETE_ENV

  // project
  READ_PROJECT
  WRITE_PROJECT
  DELETE_PROJECT

  // branch
  READ_BRANCH
  WEITE_BRANCH
  DELETE_BRANCH

  // member
  MANAGE_MEMBERS

  // billing
  MANAGE_BILLING
}

model user {
  id            String  @id @default(cuid())
  name          String?
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?

  card_token String? @unique
  plan       plan    @default(FREE)

  accounts account[]
  sessions session[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  projects         project[]
  paymentHistories payment_history[]
  members          member[]
  tokens           token[]
}

model account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, accountId])
}

model session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([identifier, value])
}

model project {
  id          String  @id @default(cuid())
  name        String
  description String?
  ownerId     String

  owner user @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches branch[]
  members  member[]
  tokens   token[]
}

model member {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  scopes    scopes[] @default([OWNER])

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, userId])
}

model branch {
  id        String  @id @default(cuid())
  name      String
  projectId String
  isMain    Boolean @default(false)

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  envs      env[]
}

model env {
  id       String @id @default(cuid())
  key      String
  value    String

  branchId String
  branch branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, branchId])
}

model payment_history {
  id            String   @id @default(cuid())
  userId        String
  plan          plan
  amount        Int
  paidAt        DateTime @default(now())
  transactionId String   @unique

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model token {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  projectId String
  expiresAt DateTime

  scopes scopes[] @default([READ_ENV])

  project project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    user    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
